{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "essence-glow--loja",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // O site (build do Vite) é servido direto pelo Cloudflare, de graça e sem
  // limite. Só chamadas /api/* passam pelo Worker.
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Roda 1x por dia para o Supabase (plano grátis) não pausar por inatividade.
  "triggers": { "crons": ["0 12 * * *"] },

  "observability": { "enabled": true }

  // Variáveis e secrets (DATABASE_URL, SUPABASE_URL, SUPABASE_ANON_KEY,
  // OWNER_OPEN_ID, MERCADOPAGO_ACCESS_TOKEN, PUBLIC_SITE_URL, RESEND_API_KEY,
  // NOTIFICATION_EMAIL) são configuradas no painel do Cloudflare.
  // Veja o arquivo CLOUDFLARE.md.
}
